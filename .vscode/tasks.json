{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build marquee",
            "command": "scripts\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile and link all sources into build\\marquee.exe"
        },
        {
            "type": "shell",
            "label": "build and run tests",
            "command": "scripts\\test.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "test",
            "detail": "Build and run the component tests"
        }
    ]
}
